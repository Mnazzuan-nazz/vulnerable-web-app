# ⚠️  WARNING: INTENTIONALLY VULNERABLE - FOR EDUCATIONAL PURPOSES ONLY ⚠️
#
# This .env file contains hardcoded secrets that are intentionally exposed.
# In a real application:
#  - This file must be in .gitignore
#  - Secrets should come from a secrets manager (Vault, AWS Secrets Manager, etc.)
#  - Rotate any key that has ever been committed to version control
#
# This file is designed to trigger:
#  - GitHub Secret Scanning
#  - truffleHog / gitleaks / detect-secrets
#  - Pre-commit hooks (if configured)

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_SECRET=my-hardcoded-app-secret-key-do-not-use

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vulnerable_app
DB_USER=admin
DB_PASSWORD=SuperSecretDBPassword123!
DB_ROOT_PASSWORD=root
DATABASE_URL=postgresql://admin:SuperSecretDBPassword123!@localhost:5432/vulnerable_app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=secret
JWT_REFRESH_SECRET=refresh-secret-also-weak

# ── AWS Credentials ───────────────────────────────────────────────────────────
